# Optional, existing Qwen server with an OpenAI-compatible API.
# Copy to .env; the application reads it on startup.
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen
QWEN_API_KEY=
# qwen = dotychczasowa analiza; opencv = eksperymentalny wybór klatek + Qwen.
# OpenCV wymaga: pip install -r requirements-opencv.txt
PRESENCE_ENGINE=qwen
# Opcjonalne oddzielne dane eksperymentu (ścieżki względem projektu):
# KUWETA_DB_PATH=data/kuweta-opencv.sqlite3
# KUWETA_RECORDINGS_DIR=data/recordings-opencv/processed
TAPO_CLOUD_PASSWORD=

# Konto kamery utworzone w Tapo (osobne od konta TP-Link).
CAMERA_HOST=192.168.0.107
CAMERA_USERNAME=
CAMERA_PASSWORD=
