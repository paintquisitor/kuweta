# Optional, existing Qwen server with an OpenAI-compatible API.
# Copy to .env; the application reads it on startup.
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen
QWEN_API_KEY=
TAPO_CLOUD_PASSWORD=

# Konto kamery utworzone w Tapo (osobne od konta TP-Link).
CAMERA_HOST=192.168.0.107
CAMERA_USERNAME=
CAMERA_PASSWORD=
